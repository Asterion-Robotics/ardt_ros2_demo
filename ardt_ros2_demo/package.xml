<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ardt_ros2_demo</name>
  <version>0.2.0</version>
  <description>Aggregator package of the ardt ROS 2 demo; also hosts the repo documentation</description>
  <maintainer email="t.poignonec@asterion-robotics.com">Thibault Poignonec</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ardt_demo_ros2_msgs</exec_depend>
  <exec_depend>ardt_ros2_demo_pkg_1</exec_depend>
  <exec_depend>ardt_ros2_demo_pkg_2</exec_depend>

  <export>
    <!-- No <metapackage/>: that marker is catkin's (ROS 1). ament ignores it,
         while catkin_pkg then demands a buildtool_depend on catkin and warns on
         every build. In ROS 2 an aggregator is just this: exec_depends, no
         targets. -->
    <build_type>ament_cmake</build_type>
  </export>
</package>
