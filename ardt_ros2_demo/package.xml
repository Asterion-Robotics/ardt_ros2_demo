<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ardt_ros2_demo</name>
  <version>0.0.0</version>
  <description>Metapackage of the ardt ROS 2 demo; also hosts the repo documentation</description>
  <maintainer email="dev@asterion-robotics.com">Asterion Robotics</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ardt_demo_ros2_msgs</exec_depend>
  <exec_depend>ardt_ros2_demo_pkg_1</exec_depend>
  <exec_depend>ardt_ros2_demo_pkg_2</exec_depend>

  <export>
    <metapackage/>
    <build_type>ament_cmake</build_type>
  </export>
</package>
